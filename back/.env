# Local dev defaults (safe placeholders). See `.env.example` for docs.
# NOTE: 127.0.0.1 is intentional here (network_mode: host); front uses `rabbitmq`.
amqp_urls=amqp://user:password@127.0.0.1:5672/
rpc_urls=rpc://
celery_concurrency=1
queue_names=queue1,queue2,queue3
exchange_name=default_exchange
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password