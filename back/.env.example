# Miminet back example env (dev defaults, safe to commit).
# Copy to `.env` for local runs: `cp .env.example .env`.
# NOTE: broker var names are lowercase by contract (amqp_urls, rpc_urls,
# exchange_name, queue_names). Do NOT rename them.
# NOTE: back uses 127.0.0.1 because it runs with `network_mode: host`
# (see back/docker-compose.yml), while front uses docker DNS `rabbitmq`.
# Do NOT unify the two values blindly.
amqp_urls=amqp://user:password@127.0.0.1:5672/
rpc_urls=rpc://
celery_concurrency=1
queue_names=queue1,queue2,queue3
exchange_name=default_exchange
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
