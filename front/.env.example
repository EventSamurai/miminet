# Miminet front example env (dev defaults, safe to commit).
# Copy to `.env` for local runs: `cp .env.example .env`.
# Real production secrets must come from environment / secrets, never committed.
# NOTE: broker var names are lowercase by contract (amqp_urls, rpc_urls,
# exchange_name). Do NOT rename them (see docs/ARCHITECTURE/SYSTEM.md).

# Broker (front uses docker DNS name `rabbitmq`; back uses 127.0.0.1 because
# it runs with `network_mode: host` — see back/.env.example).
amqp_urls=amqp://user:password@rabbitmq/
rpc_urls=rpc://
celery_concurrency=4
result_queue_name=common-results-queue
exchange_name=default_exchange
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password

# Dev-only placeholder. Override in production via environment.
JWT_SECRET_KEY=change-me-dev-only-min-32-chars

# Local PostgreSQL container (dev). Do NOT use these values in prod.
POSTGRES_DEFAULT_USER=postgres
POSTGRES_DEFAULT_PASSWORD=my_postgres
POSTGRES_DATABASE_NAME=miminet
POSTGRES_HOST=172.18.0.4

BASE_DOMAIN=local.tst
QUIZ_DOMAIN=quiz.${BASE_DOMAIN}
EXTERNAL_BASE_URL=/
QUIZ_URL=http://${QUIZ_DOMAIN}
ALLOWED_HOSTS=http://${BASE_DOMAIN},${QUIZ_URL}
# Hours
ACCESS_TOKEN_EXPIRES=3
REFRESH_TOKEN_EXPIRES=12

# Yandex Cloud PostgreSQL (prod only). Leave empty for dev.
# YANDEX_POSTGRES_HOST=your-yandex-cloud-host.mdb.yandexcloud.net
# YANDEX_POSTGRES_PORT=6432
# YANDEX_POSTGRES_USER=your_user
# YANDEX_POSTGRES_PASSWORD=your_password
# YANDEX_POSTGRES_DB=miminet
# YANDEX_POSTGRES_SSLMODE=verify-full

# Single source: only `dev` or `prod` (case/whitespace-insensitive).
# Unknown values fail fast with a clear error (see front/src/app.py).
MODE=dev
# Docker network configuration.
# If 172.18.0.0/16 (or 172.20.0.0/16) is already used by another docker network,
# pick free subnets and matching host IPs below, then:
#   docker compose down && docker compose up -d
#DOCKER_SUBNET=172.18.0.0/16
#RABBITMQ_SUBNET=172.20.0.0/16
#NGINX_IP=172.18.0.2
#MIMINET_IP=172.18.0.3
#POSTGRES_IP=172.18.0.4
# Empty = host-only JWT cookies: auth works when the app is opened by
# 127.0.0.1/localhost instead of BASE_DOMAIN. Set to .local.tst if you need
# JWT cookies shared between local.tst and quiz.local.tst.
JWT_COOKIE_DOMAIN=
